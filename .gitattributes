# Golden files are compared byte for byte; keep LF line endings on every platform.
*.json text eol=lf

# Zephyr build fixtures (scripts/regen-fixtures.sh, docs/fixtures.md). MANIFEST.json records
# the SHA-256 of every file, so checkout must never change a byte: no end-of-line conversion
# for anything under fixtures/zephyr (this overrides the *.json rule above, so it comes after
# it). objcopy writes the MCUboot zephyr.hex with CRLF line endings; everything else is LF.
fixtures/zephyr/** -text linguist-generated=true
*.elf binary
fixtures/zephyr/**/*.map -diff
