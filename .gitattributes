# Golden files are compared byte for byte; keep LF line endings on every platform.
*.json text eol=lf
crates/rollcall-core/tests/golden/report/*.md text eol=lf
crates/rollcall-core/tests/golden/diff/*.md text eol=lf

# Zephyr build fixtures (scripts/regen-fixtures.sh, docs/fixtures.md). MANIFEST.json records
# the SHA-256 of every file, so checkout must never change a byte: no end-of-line conversion
# for anything under fixtures/zephyr (this overrides the *.json rule above, so it comes after
# it). objcopy writes the MCUboot zephyr.hex with CRLF line endings; everything else is LF.
fixtures/zephyr/** -text linguist-generated=true
*.elf binary
fixtures/zephyr/**/*.map -diff

# Cargo build fixtures (scripts/regen-fixtures-cargo.sh, SHA-127): byte-exact like the Zephyr
# ones. The compact cargo metadata JSON is one long line, so it is not diffed.
fixtures/cargo-*/** -text linguist-generated=true
fixtures/cargo-*/cargo-metadata*.json -diff

# Hand-written blob test data: tests pin the SHA-256 of these files, so checkout must never
# convert line endings.
crates/rollcall-core/tests/data/blobs/** -text

# ESP-IDF build fixtures (scripts/regen-fixtures-esp-idf.sh, SHA-129): byte-exact like the
# others (MANIFEST.json pins every SHA-256). The maps are large and generated, so not diffed.
fixtures/esp-idf/** -text linguist-generated=true
fixtures/esp-idf/**/*.map -diff
fixtures/esp-idf/**/*.a binary
