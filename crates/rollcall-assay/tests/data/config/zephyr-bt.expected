# hand-written test data, SHA-144, not generated
# Fixture: fixtures/zephyr/bt, assayed with --product bt.
# sysbuild: beacon (MAIN, Bluetooth broadcaster; BT_CTLR_CRYPTO only, which is not reported), mcuboot (BOOTLOADER).
# Each line was checked against the fixture's own .config / sdkconfig (symbol, value and line);
# see README.md for the format. Do not regenerate: edit by hand, and review like code.

# Assets: IMAGE / LIBRARY / ASSET [hardware] | every evidence locator, in file and line order.
asset bootloader:mcuboot / mcuboot / RSA-PSS-2048 | mcuboot/zephyr/.config:16 CONFIG_BOOT_SIGNATURE_TYPE_RSA, mcuboot/zephyr/.config:17 CONFIG_BOOT_SIGNATURE_TYPE_RSA_LEN, zephyr/.config:55 SB_CONFIG_SIGNATURE_TYPE, zephyr/.config:57 SB_CONFIG_BOOT_SIGNATURE_TYPE_RSA
asset bootloader:mcuboot / mcuboot / SHA2-256 | mcuboot/zephyr/.config:14 CONFIG_BOOT_IMG_HASH_ALG_SHA256
asset bootloader:mcuboot / psa-crypto / RSA-PSS | mcuboot/zephyr/.config:409 CONFIG_PSA_WANT_ALG_RSA_PSS
asset bootloader:mcuboot / psa-crypto / SHA2-256 | mcuboot/zephyr/.config:412 CONFIG_PSA_WANT_ALG_SHA_256

